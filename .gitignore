test-results/
playwright-report/
__pycache__/
node_modules/
_ipa_cache.json

# 测试文件只在本地保留，不入库：避免 Playwright 用例与 Python 回归脚本被误提交
*.spec.js
*.spec.mjs
test_*.py
*_test.py
tests/

# 部署一个经过验证的英语模型；其它大模型/下载临时文件仍排除
vosk/*.tar.gz
vosk/*.part

# 端到端测试用的语音样本（vosk-api 官方 test.wav，仅本地测试用）
vosk/_test.wav

# 本机识别的部署依赖，不能只提交 JS 而遗漏模型（否则 GitHub Pages 返回 404）
!vosk/vosk-model-small-en-us-0.15.tar.gz
